{
  "app-id": "grid.streak.StreakGrid",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.7",
  "sdk": "org.kde.Sdk",
  "command": "streakgrid",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "streakgrid",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --prefix=/app -r apps/linux/requirements.txt",
        "cp -r apps/linux /app/streakgrid"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
